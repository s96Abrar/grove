#!/usr/bin/env python3
"""Local Grove CLI. No telemetry, network client or agent credentials."""
import argparse
import json
import os
import plistlib
import subprocess
import urllib.parse

parser = argparse.ArgumentParser(description='Control the Grove macOS workspace')
commands = parser.add_subparsers(dest='action', required=True)
for action, argument in [('open', 'path'), ('select', 'path'), ('new-worktree', 'branch')]:
    sub = commands.add_parser(action)
    sub.add_argument(argument)
commands.add_parser('new-tab')
sub = commands.add_parser('split')
sub.add_argument('direction', choices=['horizontal', 'vertical'])
commands.add_parser('list')
commands.add_parser('sessions')
args = parser.parse_args()
if args.action == 'list':
    result = subprocess.run(['/usr/bin/defaults', 'export', 'local.grove.workspace', '-'], capture_output=True)
    if result.returncode:
        print(json.dumps({'roots': [], 'tabs': {}}))
    else:
        values = plistlib.loads(result.stdout)
        print(json.dumps(json.loads(values.get('workspace.v2', b'{}')), indent=2))
elif args.action == 'sessions':
    subprocess.run(['/usr/bin/screen', '-list'])
else:
    values = {key: value for key, value in vars(args).items() if key != 'action'}
    if 'path' in values:
        values['path'] = os.path.abspath(os.path.expanduser(values['path']))
    if 'path' not in values and os.environ.get('GROVE_WORKTREE_PATH'):
        values['path'] = os.environ['GROVE_WORKTREE_PATH']
    url = 'grove://' + args.action + ('?' + urllib.parse.urlencode(values) if values else '')
    subprocess.run(['/usr/bin/open', url], check=True)
